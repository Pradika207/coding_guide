MONGODB_URL=
DATABASE_NAME=ai_coding_mentor
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
# Official hosted Judge0 CE: https://ce.judge0.com (availability/rate limits apply).
# RapidAPI-hosted CE: https://judge0-ce.p.rapidapi.com (requires a local API key).
# Direct CE uses X-Auth-Token; RapidAPI auth headers are selected from the URL host.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
ASSESSMENT_QUESTION_COUNT=5
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
SKILL_TRAINING_DATA_PATH=
ML_MONITORING_MINIMUM_PREDICTIONS=30
ML_MONITORING_WINDOW_SIZE=500
MIN_CANDIDATE_ACCURACY=0.60
MIN_CANDIDATE_F1=0.60
MIN_RETRAINING_SAMPLES=30
MIN_NEW_TRAINING_ROWS=30
TUTOR_PROVIDER=rule_based
TUTOR_MAX_CODE_LENGTH=50000
TUTOR_MAX_HINT_LEVEL=4
